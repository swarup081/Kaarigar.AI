# ============================================
# Kaarigar — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Firebase (Phone Auth) ---
# Firebase config is set in app.json / google-services.json

# --- AI Gateway ---
# In production: points to Supabase Edge Function URL
# Locally: points to local AI services
EXPO_PUBLIC_AI_GATEWAY_URL=http://localhost:54321/functions/v1/ai-gateway

# --- Bhashini (for AI teammate) ---
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_pipeline_id

# --- LLM (for AI teammate) ---
LLM_API_KEY=your_llm_api_key

# --- Shared API Key (between backend and AI services) ---
AI_SHARED_API_KEY=shared_secret_change_this

# --- AI Server URL (for edge function routing) ---
AI_SERVER_URL=http://localhost:8001
