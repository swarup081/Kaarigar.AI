# ============================================
# Kaarigar — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Firebase (Phone Auth) ---
# Firebase config is set in app.json / google-services.json

# --- AI Gateway ---
# Optional hosted mode only. Standalone mode calls Gemini directly.
# Enter the API key under Profile → API & environment, never in EXPO_PUBLIC_*.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash
EXPO_PUBLIC_AI_GATEWAY_URL=

# --- Bhashini (for AI teammate) ---
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_pipeline_id

# --- LLM (for AI teammate) ---
LLM_API_KEY=your_llm_api_key

# --- Shared API Key (between backend and AI services) ---
AI_SHARED_API_KEY=shared_secret_change_this

# --- AI Server URL (for edge function routing) ---
AI_SERVER_URL=http://localhost:8001

# ============================================
# Gemini — powers speech-to-text, listing
# generation and pricing reasoning.
# Get a key at https://aistudio.google.com/apikey
# ============================================
GEMINI_API_KEY=your_gemini_api_key
# gemini-3.6-flash is the pinned default. The 2.5 family is refused for keys
# issued recently ("no longer available to new users"), so do not pin it.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=90

# Set to 1 ONLY for local curl testing. Never in a deployed service.
ALLOW_UNAUTHENTICATED=0
