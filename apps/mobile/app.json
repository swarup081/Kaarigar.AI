{
  "expo": {
    "name": "Kaarigar",
    "slug": "kaarigar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaarigar",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaarigar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kaarigar needs camera access to photograph your products",
        "NSMicrophoneUsageDescription": "Kaarigar needs microphone access to record your product descriptions",
        "NSMotionUsageDescription": "Kaarigar uses motion sensors to help you take level, stable photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D84315",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.kaarigar.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "HIGH_SAMPLING_RATE_SENSORS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#D84315"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kaarigar to take photos of your products."
        }
      ],
      "expo-sensors",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
